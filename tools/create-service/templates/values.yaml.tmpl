# Helm values for {{name}}, used with the platform chart.
nameOverride: {{name}}
replicaCount: 2
image:
  repository: ghcr.io/your-org/{{name}}
  tag: ""          # set by CI to the commit SHA
containerPort: {{port}}
resources:
  requests: { cpu: 100m, memory: 128Mi }
  limits: { memory: 256Mi }
config:
  APP_ENV: dev
