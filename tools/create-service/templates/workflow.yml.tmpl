# CI for {{name}}, generated by create-service. GitHub expressions are left untouched.
name: {{name}}
on:
  pull_request:
    paths: ["services/{{name}}/**"]
  push:
    branches: [main]
    paths: ["services/{{name}}/**"]
jobs:
  test:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: services/{{name}}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - run: npm ci
      - run: npm test
      - run: echo "Built {{name}} at ${{ github.sha }}"
